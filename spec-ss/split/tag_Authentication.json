    "/auth/totp/setup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Setup do 2FA TOTP",
        "operationId": "post_suppcore_administrativobackend_auth_totpsetup",
        "requestBody": {
          "description": "Challenge token e opções para exibir/regenerar o QR-Code do 2FA.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "challenge": "challenge-token",
                  "regenerate": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dados para configuração do segundo fator."
          }
        }
      }
    },
    "/auth/totp/sendMail": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Envia o e-mail com a configuração do segundo fator baseado no challenge.",
        "operationId": "post_suppcore_administrativobackend_auth_totpsendmail",
        "requestBody": {
          "description": "Challenge token para envio da configuração do segundo fator por e-mail.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "challenge": "challenge-token"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmação do envio por e-mail."
          }
        }
      }
    },
    "/auth/totp/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verificar se o \"challenge\" confere com o \"code\" informado",
        "operationId": "post_suppcore_administrativobackend_auth_totpverify",
        "requestBody": {
          "description": "Challenge token e código TOTP informado pelo usuário.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "challenge": "challenge-token",
                  "code": "123456"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token JWT emitido após validação do segundo fator."
          }
        }
      }
    },
