{
  "tag": "Authentication",
  "paths": {
    "/auth/get_token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Endpoint action to get user Json Web Token (JWT) for authentication.",
        "operationId": "post_suppcore_administrativobackend_auth_gettoken",
        "requestBody": {
          "description": "Credentials object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "username": "username",
                  "password": "password"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON Web Token for user",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "token": {
                      "description": "Json Web Token",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "token": "_json_web_token_"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 400,
                    "message": "Bad Request"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 401,
                    "message": "Bad credentials"
                  }
                }
              }
            }
          }
        }
      }
    },
