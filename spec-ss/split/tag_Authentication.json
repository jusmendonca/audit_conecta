                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 401,
                    "message": "Bad credentials"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/auth/payload_token": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Endpoint action to get payload from Json Web Token (JWT).",
        "operationId": "get_suppcore_administrativobackend_auth_payloadtoken",
        "responses": {
          "200": {
            "description": "JSON payload from Web Token",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "iat": {
                      "description": "token creation",
                      "type": "integer"
                    },
                    "username": {
                      "description": "User name",
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "role": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "version": {
                      "description": "Version API",
                      "type": "string"
                    },
                    "exp": {
                      "description": "Version API",
                      "type": "string"
                    },
                    "checksum": {
                      "description": "Hash of api key",
                      "type": "string"
                    },
                    "id": {
                      "description": "User id",
                      "type": "integer"
                    },
                    "nome": {
                      "description": "User name",
                      "type": "string"
                    },
                    "email": {
                      "description": "User email",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "iat": 1580837366,
                    "roles": "",
                    "username": "",
                    "ip": "",
                    "version": "",
                    "exp": 1580823797,
                    "checksum": "",
                    "id": 0,
                    "nome": "",
                    "email": ""
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 401,
                    "message": "Bad credentials"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/auth/recover_password": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Endpoint to validate token and reset password.",
        "operationId": "get_suppcore_administrativobackend_auth_recoverpasswordreset",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "Username CNPJ/CPF",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Username E-Mail",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reset_token",
            "in": "query",
            "description": "reset_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success Response"
          }
        }
      },
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Endpoint to get an e-mail to recover password.",
        "operationId": "post_suppcore_administrativobackend_auth_recoverpassword",
        "requestBody": {
          "description": "Credentials object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "username": {
                    "description": "Username CPF/CNPJ",
                    "type": "string"
                  },
                  "email": {
                    "description": "Username E-Mail",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 401,
                    "message": "Bad credentials"
                  }
                }
              }
            }
          }
        }
      }
    },
