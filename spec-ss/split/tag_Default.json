                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
                    "code": 400,
                    "message": "Bad Request"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "Error code",
                      "type": "integer"
                    },
                    "message": {
                      "description": "Error description",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "example": {
